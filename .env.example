# Local fallback. Delete pipeline.db after schema changes if needed.
DATABASE_URL=sqlite:///./pipeline.db
SIMULATION_INTERVAL_SECONDS=2

# PostgreSQL example
# DATABASE_URL=postgresql+psycopg://pipeline:pipeline@localhost:5432/realtime_pipeline

# MQTT worker/simulator
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=building/sensors/#
MQTT_SIMULATION_INTERVAL_SECONDS=2
MQTT_ANOMALY_EVERY=30
